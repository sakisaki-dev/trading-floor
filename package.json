{
  "name": "trading-floor",
  "private": true,
  "type": "module",
  "description": "Agent-based simulation of a trading-card market: neural-network bots trade, learn and evolve on a simulated football league.",
  "scripts": {
    "sim": "node sim.mjs",
    "page": "node build_page.mjs",
    "tactics": "node tactics_report.mjs",
    "ai-run": "node run.mjs --config configs/pilot.json",
    "ai-dry": "node run.mjs --config configs/pilot.json --dry"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
